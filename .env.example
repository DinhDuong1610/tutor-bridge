# Copy to .env for local development. Never commit .env.
POSTGRES_DB=tutorbridge
POSTGRES_USER=tutorbridge
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=55432
TB_MIGRATOR_PASSWORD=change-me-local-only
TB_APP_PASSWORD=change-me-local-only
# Deployed backends must also set TUTORBRIDGE_SECURITY_ADMIN_ORIGINS to the admin web origin;
# the local profile allows http://localhost:3000. Mobile and web have their own .env.example.
# Identity keys (TB-8): base64 of 32 random bytes each, different for every key and environment.
# Generate one with: openssl rand -base64 32. The backend refuses to start without them.
TB_EMAIL_DIGEST_KEY=
TB_EMAIL_ENCRYPTION_KEY=
TB_LINK_TOKEN_KEY=
# Accepted RegistrationInput.termsVersion values, comma separated. The local profile defaults to a
# trial version with no legal effect; leave this commented out to keep it (an empty value disables registration).
# TB_TERMS_VERSIONS=
# Local mail catcher (Mailpit in infra/compose.yaml); the local profile sends there.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# Deployed API: TB_EVIDENCE_DIR, a directory every instance shares (tutor evidence). The local
# profile uses backend/build/local-evidence when it is unset.
# Deployed worker role only: TB_WORKER_ENABLED=true, TB_MAIL_FROM, TB_LINK_BASE (https domain ending
# in /) and SMTP through SPRING_MAIL_HOST, SPRING_MAIL_PORT, SPRING_MAIL_USERNAME, SPRING_MAIL_PASSWORD.
