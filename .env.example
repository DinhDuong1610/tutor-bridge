# Copy to .env for local development. Never commit .env.
POSTGRES_DB=tutorbridge
POSTGRES_USER=tutorbridge
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=55432
TB_MIGRATOR_PASSWORD=change-me-local-only
TB_APP_PASSWORD=change-me-local-only
