# Copy to mobile/.env.local. Expo inlines EXPO_PUBLIC_ values into the app: never put a secret here.
# Android emulator reaches the host as 10.0.2.2. A phone on the same network needs the computer's LAN IP.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api/v1
# Terms version sent with AUTH01 registration. Source still TBD (docs/handoff/TB-10.md, Q2);
# without it the app refuses to send the form.
# EXPO_PUBLIC_TERMS_VERSION=
