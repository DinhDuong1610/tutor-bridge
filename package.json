{
  "name": "tutorbridge",
  "private": true,
  "workspaces": [
    "packages/*",
    "mobile",
    "web"
  ],
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "generate:api": "npm run generate --workspace @tutorbridge/api-client",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-test-renderer": "19.2.3"
  }
}
