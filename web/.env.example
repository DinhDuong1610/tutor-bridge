# Copy to web/.env.local. Read on the server only; nothing here reaches the browser.
TB_API_URL=http://127.0.0.1:8080/api/v1
# This web's origin. The API accepts cookie writes only from origins in
# tutorbridge.security.admin-origins (the backend local profile allows http://localhost:3000).
TB_WEB_ORIGIN=http://localhost:3000
# Trusted proxies in front of the one that saw the browser, counted from the right of X-Forwarded-For
# (#252). Deployed, Next sits behind a proxy that appends the peer address (nginx: $proxy_add_x_forwarded_for);
# 0 then takes that last entry. Add one per further proxy (a CDN, say). The API must list this server in
# TUTORBRIDGE_SECURITY_TRUSTED_WEB_PROXIES to believe it.
TB_CLIENT_IP_HOPS=0
