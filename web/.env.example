# Copy to web/.env.local. Read on the server only; nothing here reaches the browser.
TB_API_URL=http://127.0.0.1:8080/api/v1
# This web's origin. The API accepts cookie writes only from origins in
# tutorbridge.security.admin-origins (the backend local profile allows http://localhost:3000).
TB_WEB_ORIGIN=http://localhost:3000
